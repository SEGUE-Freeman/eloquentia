# Copier en .env et renseigner. Ne jamais versionner le .env.

# --- Transcription (Whisper via une API compatible OpenAI) ---
# Groq est le plus rapide et le moins cher pour whisper-large-v3.
# Alternatives : api.openai.com/v1, fireworks.ai, ou un serveur
# faster-whisper auto-hébergé exposant la même route.
ELOQ_STT_PROVIDER=openai_compatible
ELOQ_STT_BASE_URL=https://api.groq.com/openai/v1
ELOQ_STT_API_KEY=
ELOQ_STT_MODEL=whisper-large-v3

# --- Analyse (modèle open source via une API compatible OpenAI) ---
# Le critère de choix numéro un est la qualité en FRANÇAIS.
# Mistral Large / Mistral Small : excellents en français, API native.
# Qwen 2.5 72B, Llama 3.3 70B : corrects, via Together ou OpenRouter.
ELOQ_LLM_PROVIDER=openai_compatible
ELOQ_LLM_BASE_URL=https://api.mistral.ai/v1
ELOQ_LLM_API_KEY=
ELOQ_LLM_MODEL=mistral-large-latest

# Température 0 : indispensable pour que deux analyses de la même prestation
# donnent la même note. Ne pas augmenter.
ELOQ_LLM_TEMPERATURE=0

ELOQ_TIMEOUT_S=120
ELOQ_DATA_DIR=data
